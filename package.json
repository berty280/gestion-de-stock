{
  "name": "comptoir",
  "version": "0.1.0",
  "private": true,
  "description": "Comptoir — gestion de stock + traçabilité (cosmétiques / hygiène / parapharmacie)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace backend",
    "db:seed": "npm run seed --workspace backend",
    "db:reset": "npm run reset --workspace backend"
  },
  "engines": {
    "node": ">=20"
  }
}
