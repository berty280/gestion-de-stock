# --- Comptoir backend configuration ---

# HTTP server
PORT=3000
HOST=0.0.0.0

# Comma-separated list of allowed origins for CORS (frontend dev server, etc.)
CORS_ORIGIN=http://localhost:5173

# SQLite database file (relative to backend/ or absolute)
DATABASE_PATH=./data/comptoir.db

# Auth (used from step 2 onward)
JWT_SECRET=change-me-in-production

# Default passwords assigned to seeded accounts (dev only — change in production)
SEED_DEFAULT_PASSWORD=comptoir123

# SMTP (used from step 6 onward — supplier reorder emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Comptoir <no-reply@example.com>"
ALERT_EMAIL_TO=
